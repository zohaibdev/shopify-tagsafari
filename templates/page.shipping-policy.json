{
  "sections": {
    "policy": {
      "type": "ts-policy",
      "blocks": {
        "section_1": {
          "type": "section",
          "settings": {
            "heading": "Delivery Policy",
            "text": "<p>Thank you for shopping with <strong>TagSafari.com</strong>. Below, you will find our shipping and delivery policy outlining our processes and guidelines for shipping orders to our customers.</p>"
          }
        },
        "section_2": {
          "type": "section",
          "settings": {
            "heading": "Processing Time",
            "text": "<p>Orders placed with us require up to <strong>1 business day</strong> for processing before they are dispatched. Please note that processing time does not include shipping time.</p><p>Orders received by 12 noon are shipped on the same day we receive them, except orders received during weekends and holidays are shipped on the first business day thereafter</p>"
          }
        },
        "section_3": {
          "type": "section",
          "settings": {
            "heading": "Shipping Methods & Costs",
            "text": "<p>We offer the following shipping methods:</p><ul><li><strong>Local Services within the USA (USPS) – Free of charge</strong></li><li><strong>Courier Services – Chargeable</strong> (costs vary based on service and location)</li><li>We use FedEx Ground and FedEx Air for overseas shipments.</li></ul>"
          }
        },
        "section_4": {
          "type": "section",
          "settings": {
            "heading": "Delivery Timeframes",
            "text": "<ul><li><strong>USA Deliveries:</strong> Estimated delivery time is<strong>up to 3 days</strong>. However, delivery times are <strong>not guaranteed</strong>, and we do not offer discounts or refunds for transport delays.</li><li><strong>International Deliveries:</strong> Estimated delivery time is <strong>up to 10 days</strong>, depending on the destination. We aim to use the fastest available shipping method, but <strong>delivery times are not guaranteed</strong>. We do not provide discounts or refunds for transport delays.</li></ul>"
          }
        },
        "section_5": {
          "type": "section",
          "settings": {
            "heading": "Tracking Information",
            "text": "<p>Where applicable or available, tracking information will be provided to customers once the order has been dispatched.</p>"
          }
        },
        "section_6": {
          "type": "section",
          "settings": {
            "heading": "Duties & Taxes",
            "text": "<p>Customers in Canada and Mexico should expect additional Taxes and Duties collected by their Customs Departments.</p><p>All consignments are shipped under <strong>Delivered at Place (DAP) terms.</strong> This means we do <strong>not cover local country duties or taxes -</strong> these are the responsibility of the buyer and are <strong>not included in our prices.</strong></p>"
          }
        },
        "section_7": {
          "type": "section",
          "settings": {
            "heading": "Returns & Refunds",
            "text": "<p>For information on returns and refunds, please refer to our policies at the links below:</p><ul><li><a href=\"https://tagsafari.co.uk/pages/request-return-authorization\">Request Return Authorization</a></li><li><a href=\"/pages/exchange-return-policy\">Exchange &amp; Return Policy</a></li></ul><p>If you have any questions regarding our delivery policy, please feel free to contact us.</p>"
          }
        }
      },
      "block_order": [
        "section_1",
