        "guide_1": {
          "type": "guide",
          "settings": {
            "category": "Men",
            "title": "How to Measure Men's Shirts, Jackets, and Vests",
            "steps": "Neck Circumference: Measure all the way around your neck. Allow a bit of extra room for wearing comfort.\nSleeve Length: Measure the length of your arm, beginning from the center of your neck in back and ending where your hand joins the wrist.\nChest: Take a breath, hold it, and measure around your upper chest under your arms.\nBack Length: Measure from the collar seam in back down to the bottom of the hem.",
            "image": "shopify://shop_images/shirt.png"
          }
        },
