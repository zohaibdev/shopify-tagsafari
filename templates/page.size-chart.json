        "guide_5": {
          "type": "guide",
          "settings": {
            "category": "Men",
            "title": "How to Measure Men's Pants and Shorts",
            "steps": "Waist: Measure all the way around your natural waistline, or where you actually wear your pants. Allow a bit of extra room for movement and for tucking in a shirt\nSeat/Hip: Standing with your feet together, measure around the fullest part of your hip (approx. 7-8\" below the waist). Don’t forget to keep the tape level.\nInseam: Best taken from an existing pair of pants you like. Measure along the garment inseam from your crotch seam to the hem.",
            "image": "shopify://shop_images/pent.png"
          }
        },
