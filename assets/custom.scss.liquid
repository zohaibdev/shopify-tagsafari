ul.parent {
    display: flex;
    flex-wrap: wrap;
    background: #218877;
    padding-bottom: 0;
    z-index: 11;
    position: relative;

    >li {
        position: relative;
        padding: 15px;
        list-style: none;
        cursor: pointer;

        >a {
            color: #fff;
        }

        ul.child {
            position: absolute;
            z-index: 11;
            background: #fff;
            top: 49px;
            min-width: 250px;
            display: none;

            >li {
                &:first-child {
                    border-top: 1px solid #e32e00;
                }

                position: relative;
                list-style: none;
                padding:10px 0;
                border-bottom: 1px solid #e32e00;

                >a {
                    padding: 0 5px;
                    font-size: 14px;

                    &:hover {
                        text-decoration: none;
                    }
                }

                >ul.grandchild {
                    position: absolute;
                    left: 100%;
                    background: #fff;
                    padding: 20px;
                    list-style: none;
                    display: none;
                    top: 0;
                    min-width: 250px;
                }

                &:hover {
                    text-decoration: none;

                    ul.grandchild {
                        display: block;

                        >li a {
                            padding: 0 5px;
                            font-size: 14px;
                        }
                    }
                }
            }
        }

        &:hover ul.child {
            display: block;
        }
    }
}

