      "faq": {
        "type": "faq",
        "blocks": {
          "550285ac-9833-4679-aa7f-a0f3ba86f13f": {
            "type": "select",
            "settings": {
              "heading": "What does Tag stand for?",
              "description": "\"Tag\" is the official hunting license number issued by the department of wildlife management in Zimbabwe. The tag is fixed to the kill to indicate a legal hunt. The \"Tag\" ( a round numbered perspex disc ) helps prevent poaching and is useful in conservation of wildlife resources as taxidermists and trophy processors use it to identify legal trophies."
            }
          },
          "e7d8cd2d-6c00-4a84-a08a-4602af4cdb27": {
            "type": "select",
            "settings": {
              "heading": "Where are the products made?",
              "description": "Products are made at our plant in Zimbabwe Africa, by a team of highly trained workers. All workers are paid a fair wage, negotiated through a collective bargaining agreement between employers, employees and unions."
            }
          },
          "7c85b124-efa7-4b03-baa7-3db1c576628e": {
            "type": "select",
            "settings": {
              "heading": "What are the clothes made of?",
              "description": "All our clothing is made of 100% Zimbabwean cotton. The high quality long staple cotton is grown (mostly by peasant farmers) and processed into cloth, by world class cloth mills."
            }
          },
          "34e738aa-2171-4267-868b-999af3bede55": {
            "type": "select",
            "settings": {
              "heading": "How do the sizes run?",
              "description": "The clothes are generously sized, and run true to American specifications. The size chart on the site will provide measurements to accurately select your proper size."
            }
          },
          "6c63db76-2ce5-4df7-9043-3114c32723ea": {
            "type": "select",
            "settings": {
              "heading": "How much will the clothes shrink?",
              "description": "\"Tag\" clothing is made of \"pigment dyed\" cloth. The washing process removes most of the excess pigment before leaving our factory. This gives the garments a \"worn look.\" Following the sewn in wash care label will prevent further color loss."
            }
          },
          "31e50550-c436-48fa-9e45-1335bfbc2a61": {
            "type": "select",
            "settings": {
              "heading": "Will the clothes fade?",
              "description": "\"Tag\" clothing is made of \"pigment dyed\" cloth. The washing process removes most of the excess pigment before leaving our factory. This gives the garments a \"worn look.\" Following the sewn in wash care label will prevent further color loss."
            }
          },
          "897748b0-3757-4909-ae7c-e6b0944a6260": {
            "type": "select",
            "settings": {
              "heading": "What about the buttons?",
              "description": "All garments are fitted with \"four hole\" polyester resin buttons, tightly sewn through all four holes. These buttons will withstand heavy washing and pressing. We provide \"two\" extra buttons sewn into every shirt and \"one\" on every pair of pants and other garment. We use only the best buttons and trims available."
            }
          },
          "49192f28-aef6-46f3-9201-156fb8a3e77a": {
            "type": "select",
            "settings": {
              "heading": "What is pigment dyeing?",
              "description": "Cloth can be vat dyed in a water based \"wet process\" called reactive dyeing or \"pigment dyed\" dry on the stenter table using a p.v.a. type dye.\nWe use the pigment process with environment friendly dye stuff."
            }
          },
          "c4a96da5-c007-4306-b1bb-97c0a373e3ad": {
            "type": "select",
            "settings": {
              "heading": "What about the thread used to sew the garments?",
              "description": "We use only high quality imported polyester thread with a high tensile strength and high melting point to make our stitching withstand the stresses of nature and the heavy use we expect them to endure."
            }
          },
          "1c4ce961-0024-4d66-89ec-b9de62c01035": {
            "type": "select",
            "settings": {
              "heading": "What if the clothes don't fit me?",
              "description": "We want you to be fully satisfied with your purchase. We will exchange any garment returned to us in the original condition without exception. We will gladly refund the purchase price if returned to us within fourteen days of shipping. We will promptly replace any clothing that has slipped past our stringent quality control, and pay the shipping cost for the replacement. \"We believe in our products and respect our customers\""
            }
          },
          "c5ea3e06-c43c-4e2e-b2f4-32c2a302a3ee": {
            "type": "select",
            "settings": {
              "heading": "What about custom orders?",
              "description": "Custom orders can be done. A minimum quantity of 240 garments is required. These can be in different colors and sizes of one product. Delivery would take twelve weeks. This will be confirmed after the detailed order is received and may be sooner or later depending on the time of year."
            }
          },
          "f6dc6a6a-5a46-4d71-bdea-72bf35ea8603": {
            "type": "select",
            "settings": {
              "heading": "What about custom logos?",
              "description": "We can arrange to have custom logos done for you. The extra cost will depend on the logo and quantity ordered, and will be quoted once artwork is received in the acceptable format. Generally, custom production runs of 240 garments requiring logos are done at our factory in Africa. Smaller quantities can be done in the U.S. We can handle this for you. Note: all custom work and logo orders must be paid for in full before any work can commence."
            }
          },
          "ba89d993-0d25-4526-a196-5b62bd2422ad": {
            "type": "select",
            "settings": {
              "heading": "How do I make payment for my order?",
              "description": "Payments can be made by Visa or Mastercard."
            }
          },
          "012a7572-e70a-4ba9-8251-7148e937ab9e": {
            "type": "select",
            "settings": {
              "heading": "What about sales tax?",
              "description": "Sales tax is collected on all sales, except dealers with registered tax I.D. who are purchasing for resale."
            }
          },
          "af7ca090-bc9c-4d23-a022-34b925182d40": {
            "type": "select",
            "settings": {
              "heading": "How long will it take to receive the order?",
              "description": "All items on our online shopping site are available in our warehouse for next day shipment. In the event that the item is temporarily out of stock, you may elect to choose another similar product, or place an order with us. We will ship it as soon as it is available again."
            }
          },
          "65a0632d-7672-4ea8-87b3-f860a49e5a16": {
            "type": "select",
            "settings": {
              "heading": "How do I become a \"Tag\" dealer?",
              "description": "We have a strong, professional distribution and dealer policy and all dealers must be pre-approved before they can receive the benefits available to \"Tag\" dealers. Prospective dealers must among other things satisfy us of their ability and willingness to serve our customers well. They must submit a sound business plan for the proposed market region, and proof of financial stability. We will in turn give approved dealers comprehensive training and support to achieve their goals. Ask us about dealer opportunities in your area by emailing us at sales@tagsafari.com"
            }
          }
        },
