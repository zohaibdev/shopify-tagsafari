{%- liquid
  if template.name == 'blog'
    assign default_title = blog.title
  else
    assign default_title = page.title
  endif
  assign banner_title = section.settings.title | default: default_title
  assign banner_image = section.settings.background_image
-%}

<div class="coll-banner__wrapper{% if banner_image == blank %} coll-banner__wrapper--plain{% endif %}"{% if banner_image != blank %} style="background-image: url('{{ banner_image | image_url: width: 2400 }}');"{% endif %}>
    <div class="container">
        {%- if section.settings.show_breadcrumbs -%}
        <nav class="coll-banner__breadcrumbs" aria-label="{{ 'general.breadcrumbs.breadcrumbs' | t }}">
            <ul class="breadcrumb">
                <li><a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a></li>
                {%- if section.settings.parent_label != blank and section.settings.parent_link != blank -%}
                    <li><a href="{{ section.settings.parent_link }}">{{ section.settings.parent_label }}</a></li>
                {%- endif -%}
                {%- if template.name == 'blog' and current_tags -%}
                    <li><a href="{{ blog.url }}">{{ blog.title }}</a></li>
                    <li>{{ current_tags | join: ', ' }}</li>
                {%- else -%}
                    <li>{{ banner_title }}</li>
                {%- endif -%}
            </ul>
        </nav>
        {%- endif -%}

        <div class="coll-banner__content">
            <h1 class="coll-banner__title">{{ banner_title }}</h1>
            {%- if section.settings.content != blank -%}
                <div class="coll-banner__description">{{ section.settings.content }}</div>
            {%- endif -%}
            {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
                <a href="{{ section.settings.button_link }}" class="th-btn coll-banner__button">{{ section.settings.button_label }}</a>
            {%- endif -%}
        </div>
    </div>
</div>

{% schema %}
{
  "name": "Page Banner",
  "tag": "section",
  "class": "coll-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "info": "Leave blank to use the page or blog title"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "text",
      "id": "parent_label",
      "label": "Parent breadcrumb label"
    },
    {
      "type": "url",
      "id": "parent_link",
      "label": "Parent breadcrumb link"
    }
  ],
  "presets": [
    {
      "name": "Page Banner"
    }
  ]
}
{% endschema %}
