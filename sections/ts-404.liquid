{%- comment -%} 404 page: friendly message, search, ways back into the store and popular collections. {%- endcomment -%}
<div class="ts-404">
    <div class="container">
        <div class="ts-404__hero">
            <div class="ts-404__art" aria-hidden="true">
                <svg viewBox="0 0 220 160" width="220" height="160" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                    <path d="M18 132h184" opacity=".35"/>
                    <path d="M40 132c8-22 20-34 36-38M180 132c-6-18-16-28-30-32" opacity=".35"/>
                    <circle cx="80" cy="74" r="30"/>
                    <circle cx="140" cy="74" r="30"/>
                    <path d="M110 70c0-6-4-10-10-10M110 70c0-6 4-10 10-10M50 74V54a10 10 0 0 1 10-10h10M170 74V54a10 10 0 0 0-10-10h-10"/>
                    <path d="M70 66a12 12 0 0 1 12-8M130 66a12 12 0 0 1 12-8" opacity=".6"/>
                </svg>
                <span class="ts-404__code">404</span>
            </div>
            {%- if section.settings.eyebrow != blank -%}<span class="ts-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
            <h1 class="ts-404__title">{{ section.settings.heading }}</h1>
            {%- if section.settings.text != blank -%}<div class="ts-404__text">{{ section.settings.text }}</div>{%- endif -%}

            <form action="{{ routes.search_url }}" method="get" role="search" class="ts-search-bar ts-404__search">
                <label class="ts-search-bar__label" for="NotFoundSearch">Search the store</label>
                <span class="ts-search-bar__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" focusable="false"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                </span>
                <input type="search" id="NotFoundSearch" name="q" class="ts-search-bar__input" placeholder="{{ section.settings.search_placeholder | escape }}" autocomplete="off">
                <button type="submit" class="ts-search-bar__button">Search</button>
            </form>

            <div class="ts-404__actions">
                <a href="{{ routes.root_url }}" class="ts-btn ts-btn--primary">Back to home</a>
                <a href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}" class="ts-btn ts-btn--outline">{{ section.settings.shop_label }}</a>
            </div>
        </div>

        {%- if section.settings.collections != blank -%}
            {%- assign suggested = section.settings.collections -%}
        {%- else -%}
            {%- assign suggested = collections -%}
        {%- endif -%}
        <div class="ts-404__suggest">
            <h2 class="ts-404__suggest-title">{{ section.settings.collections_heading }}</h2>
            <ul class="ts-collection-grid" role="list">
                {%- assign shown = 0 -%}
                {%- for collection in suggested -%}
                    {%- if shown >= 4 -%}{%- break -%}{%- endif -%}
                    {%- if collection.handle == 'frontpage' or collection.products_count == 0 -%}{%- continue -%}{%- endif -%}
                    {%- assign shown = shown | plus: 1 -%}
                    <li>
                        <a href="{{ collection.url }}" class="ts-collection-card">
                            <span class="ts-collection-card__media">
                                {%- assign c_image = collection.featured_image | default: collection.products.first.featured_image -%}
                                {%- if c_image -%}
                                    {{ c_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250, 400, 500', sizes: '(min-width: 1025px) 25vw, 50vw', alt: '' }}
                                {%- else -%}
                                    {%- render 'ts-icon', icon: 'compass' -%}
                                {%- endif -%}
                            </span>
                            <span class="ts-collection-card__title">{{ collection.title }}</span>
                        </a>
                    </li>
                {%- endfor -%}
            </ul>
        </div>
    </div>
</div>

{% schema %}
{
  "name": "404 Page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Off the beaten track"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We couldn't find that page"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>The page you were looking for may have moved or no longer exists. Try a search, or head back to explore our safari clothing and gear.</p>"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search for shirts, hats, belts..."
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "Second button label",
      "default": "Shop all products"
    },
    {
      "type": "url",
      "id": "shop_link",
      "label": "Second button link"
    },
    {
      "type": "text",
      "id": "collections_heading",
      "label": "Collections heading",
      "default": "Popular collections"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "limit": 4,
      "info": "Leave empty to show the store's first collections"
    }
  ]
}
{% endschema %}
