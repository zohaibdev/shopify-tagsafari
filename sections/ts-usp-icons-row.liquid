<div class="usp-icons-row__wrapper">
    <div class="container">
        <div class="usp-icons-row__items">
            {% for block in section.blocks %}
                <div class="usp-icons-row__item">
                    {% if block.settings.icon %}
                        <img src="{{ block.settings.icon | img_url: 'medium' }}" alt="{{ block.settings.title }}">
                    {% endif %}
                    <h3>{{ block.settings.title }}</h3>
                    <p>{{ block.settings.subtitle }}</p>
                </div>
            {% endfor %}
        </div>
    </div>
</div>


{% schema %}
{
  "name": "USP Icons Row",
  "tag": "section",
  "class": "usp-icons-row",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Shop With Us"
    }
  ],
  "blocks": [
    {
      "type": "usp_item",
      "name": "USP Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free 2-Day Shipping"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Contiguous USA only"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "USP Icons Row",
      "blocks": [
        {
          "type": "usp_item"
        },
        {
          "type": "usp_item"
        },
        {
          "type": "usp_item"
        },
        {
          "type": "usp_item"
        }
      ]
    }
  ]
}
{% endschema %}
