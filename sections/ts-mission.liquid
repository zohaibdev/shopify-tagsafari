<div class="{% if section.settings.is_full_width == false %}container{% else %}container-fluid{% endif %}">
    <div class="mission__wrapper" style="background-image: url({{ section.settings.side_image | img_url: '2048x2048' }});">
        <div class="mission__content">
            {% if section.settings.badge_image %}
                <img src="{{ section.settings.badge_image | img_url: 'medium' }}" alt="Badge" class="mission__badge">
            {% endif %}
            <div class="mission__text">
                <h2 class="mission__heading">{{ section.settings.heading }}</h2>
                <p class="mission__description">{{ section.settings.description }}</p>
                {% if section.settings.button_link %}
                    <a href="{{ section.settings.button_link }}" class="th-btn">{{ section.settings.button_label }}</a>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{% schema %}
{
  "name": "Mission Banner",
  "tag": "section",
  "class": "mission",
  "settings": [
    {
      "type": "checkbox",
      "label": "Is Full Width",
      "id": "is_full_width"
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "Badge image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Helping Africa Through Trade, Not Aid"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every product you buy creates jobs, supports families, and builds a stronger future for Africa."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Our Mission"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "side_image",
      "label": "Right-side image"
    }
  ],
  "presets": [
    {
      "name": "Mission Banner"
    }
  ]
}
{% endschema %}
