<div class="container">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
        <div class="title-block">
            {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
            {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        </div>
    {%- endif -%}
    <div class="ts-card-grid" style="--col: {{ section.settings.columns }}">
        {%- for block in section.blocks -%}
            {%- liquid
              assign card_blog = nil
              assign card_image = block.settings.image
              if block.type == 'blog'
                assign card_blog = block.settings.blog
                assign card_url = card_blog.url
                assign card_title = block.settings.title | default: card_blog.title
                if card_image == blank
                  for article in card_blog.articles
                    if article.image
                      assign card_image = article.image
                      break
                    endif
                  endfor
                endif
              else
                assign card_url = block.settings.link
                assign card_title = block.settings.title
              endif
            -%}
            {%- if card_url != blank -%}
            <article class="ts-post" {{ block.shopify_attributes }}>
                {%- if card_image != blank -%}
                    <div class="ts-post__media">
                        {{ card_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 1025px) 380px, (min-width: 768px) 50vw, 100vw', alt: '' }}
                    </div>
                {%- elsif section.settings.fallback_image != blank -%}
                    <div class="ts-post__media ts-post__media--fallback">
                        {{ section.settings.fallback_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}
                    </div>
                {%- endif -%}
                <div class="ts-post__body">
                    {%- if card_blog -%}
                        <p class="ts-post__meta">{{ card_blog.articles_count }} {{ card_blog.articles_count | pluralize: 'article', 'articles' }}</p>
                    {%- elsif block.settings.eyebrow != blank -%}
                        <p class="ts-post__meta">{{ block.settings.eyebrow }}</p>
                    {%- endif -%}
                    <h3 class="ts-post__title"><a href="{{ card_url }}">{{ card_title }}</a></h3>
                    {%- if block.settings.description != blank -%}
                        <p class="ts-post__excerpt">{{ block.settings.description }}</p>
                    {%- endif -%}
                    {%- if card_blog and section.settings.show_latest -%}
                        <ul class="ts-post__list">
                            {%- for article in card_blog.articles limit: 4 -%}
                                <li>{{ article.title }}</li>
                            {%- endfor -%}
                        </ul>
                    {%- endif -%}
                    <span class="ts-post__link">{{ block.settings.link_label | default: 'Explore' }}</span>
                </div>
            </article>
            {%- endif -%}
        {%- endfor -%}
    </div>
</div>

{% schema %}
{
  "name": "Blog Hub",
  "tag": "section",
  "class": "ts-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Safari Blog"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro text"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_latest",
      "label": "List latest article titles on blog cards",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "fallback_image",
      "label": "Image for cards without one",
      "info": "Shown on a tinted background, e.g. the TAG® Safari badge"
    }
  ],
  "blocks": [
    {
      "type": "blog",
      "name": "Blog",
      "settings": [
        {
          "type": "blog",
          "id": "blog",
          "label": "Blog"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Leave blank to use the blog title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Defaults to the first article image"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Explore"
        }
      ]
    },
    {
      "type": "link",
      "name": "Page link",
      "settings": [
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow text"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Travel guide"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Read more"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blog Hub",
      "blocks": [
        { "type": "blog" },
        { "type": "blog" },
        { "type": "blog" }
      ]
    }
  ]
}
{% endschema %}
