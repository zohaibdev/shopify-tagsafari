<div class="container">
    <div class="gears__content">
        {% if section.settings.heading != blank %}
          <div class="title-block">
              <h2 class="title-block__heading">{{ section.settings.heading }}</h2>
          </div>
        {% endif %}
        <div class="gears__tiles" style="--col: {{ section.settings.columns }}">
            {% for block in section.blocks %}
                <div class="gears__tile"{% if block.settings.image != blank %} style="background-image: url('{{ block.settings.image | image_url: width: 800 }}');"{% endif %}>
                    <h3 class="gears__tile-title">{{ block.settings.title }}</h3>
                    <p class="gears__tile-description">{{ block.settings.description }}</p>
                    {% if block.settings.button_link != blank %}
                        <a href="{{ block.settings.button_link }}" class="th-btn">{{ block.settings.button_label }}</a>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div
></div>

{% schema %}
{
  "name": "Essential Gear Tiles",
  "tag": "section",
  "class": "gears",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Essential Gear for Every Adventure"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 1,
      "max": 4,
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Gaiters"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Keep stickers, stones and sand out."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Essential Gear Tiles",
      "blocks": [
        {
          "type": "tile"
        },
        {
          "type": "tile"
        },
        {
          "type": "tile"
        }
      ]
    }
  ]
}
{% endschema %}
