{% paginate search.results by section.settings.products_per_page %}
{%- comment -%}
  Search header, tabs and article/page results around the Boost product search. Boost still drives the
  product grid, filters and the heading/count text, so its class names stay on those elements.
{%- endcomment -%}
{%- assign content_count = 0 -%}
{%- for result in search.results -%}
  {%- if result.object_type == 'article' or result.object_type == 'page' -%}{%- assign content_count = content_count | plus: 1 -%}{%- endif -%}
{%- endfor -%}
<div class="boost-pfs-filter-collection-header-wrapper boost-pfs-search-form-wrapper ts-search-hero">
  <div class="boost-pfs-search-container boost-pfs-container-default">
    <span class="ts-eyebrow">Search</span>
    <h1 class="boost-pfs-search-result-header ts-search-hero__title">{% if search.performed %}Results for &ldquo;{{ search.terms | escape }}&rdquo;{% else %}Search our store{% endif %}</h1>
    <form class="boost-pfs-search-form ts-search-bar" action="{{ routes.search_url }}" method="get" role="search">
      <label class="ts-search-bar__label" for="SearchPageInput">Search the store</label>
      <span class="ts-search-bar__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" focusable="false"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </span>
      <input class="boost-pfs-search-box ts-search-bar__input" id="SearchPageInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search for shirts, hats, belts..." autocomplete="off">
      <button type="submit" class="boost-pfs-search-btn ts-search-bar__button">Search</button>
    </form>
    <p class="boost-pfs-search-result-number ts-search-hero__count"></p>
  </div>
</div>

{%- if content_count > 0 -%}
<div class="ts-search-tabs-wrap">
  <div class="ts-search-tabs" role="tablist" aria-label="Search results">
    <button type="button" class="ts-search-tabs__tab" role="tab" id="SearchTabProducts" aria-controls="SearchPanelProducts" aria-selected="true" data-search-tab="products">Products</button>
    <button type="button" class="ts-search-tabs__tab" role="tab" id="SearchTabContent" aria-controls="SearchPanelContent" aria-selected="false" tabindex="-1" data-search-tab="content">Articles &amp; pages <span class="ts-search-tabs__count">{{ content_count }}</span></button>
  </div>
</div>
{%- endif -%}

<div id="SearchPanelProducts" {% if content_count > 0 %}role="tabpanel" aria-labelledby="SearchTabProducts" {% endif %}data-search-panel="products">
{% comment %} TOOLBAR TOP MOBILE {% endcomment %}
<div class="boost-pfs-filter-toolbar-top-mobile">
    <div class="boost-pfs-filter-top-sorting boost-pfs-filter-top-sorting-mobile boost-pfs-filter-custom-sorting">{% include 'boost-pfs-filter-skeleton', type: 'button' %}</div>
    <div class="boost-pfs-filter-tree-mobile-button">{% include 'boost-pfs-filter-skeleton', type: 'button' %}</div>
</div>
{% comment %} END TOOLBAR TOP MOBILE {% endcomment %}
{% comment %} TOOLBAR {% endcomment %}
<div class="boost-pfs-filter-default-toolbar">
    <div class="container boost-pfs-filter-default-toolbar-inner">
      <div class="boost-pfs-filter-toolbar-item boost-pfs-filter-toolbar-count">
        <span class="boost-pfs-filter-total-product">{% include 'boost-pfs-filter-skeleton', width: 1 %}</span>
      </div>
      <div class="sort-by-filter">
        <span class="sort-by__label">Sort By</span>
        <div class="boost-pfs-filter-toolbar-item boost-pfs-filter-custom-sorting boost-pfs-filter-top-sorting">{% include 'boost-pfs-filter-skeleton', width: 1 %}</div>
      </div>
    </div>
</div>
{% comment %} END TOOLBAR {% endcomment %}

<div class="container boost-pfs-filter-wrapper-page">
  {% assign products_per_page = section.settings.products_per_page %}
  <div class="boost-pfs-filter-wrapper">

    <div class="boost-pfs-filter-left-col">
      <div class="boost-pfs-filter-refine-by-wrapper-v"></div>
      <div class="boost-pfs-filter-tree boost-pfs-filter-tree-v">{% include 'boost-pfs-filter-skeleton', type: 'filter-tree' %}</div>
    </div>
    <div class="boost-pfs-filter-right-col">
      <div class="boost-pfs-filter-products boost-pfs-filter-swatch-shape-{{ section.settings.swatches_color_shape}} boost-pfs-filter-product-item-text-alignment-{{ section.settings.text_alignment}}">
        {%- for result in search.results -%}
          {%- if result.object_type == 'product' -%}
              {% include 'boost-pfs-filter-product-item', product: result %}
          {%- endif -%}
        {% endfor %}
      </div>
    </div>
    <div class="boost-pfs-filter-bottom-pagination boost-pfs-filter-bottom-pagination-default">
      {% if paginate.pages > 1 %}
          {% include 'boost-pfs-filter-pagination' %}
      {% endif %}
    </div>
    <div class="boost-pfs-filter-load-more"></div>
  </div>
</div>
</div>

{%- if content_count > 0 -%}
<div class="ts-search-content" id="SearchPanelContent" role="tabpanel" aria-labelledby="SearchTabContent" data-search-panel="content" hidden>
  <div class="container">
    <ul class="ts-result-grid" role="list">
      {%- for result in search.results -%}
        {%- unless result.object_type == 'article' or result.object_type == 'page' -%}{%- continue -%}{%- endunless -%}
        <li>
          <a href="{{ result.url }}" class="ts-result-card">
            {%- if result.object_type == 'article' and result.image -%}
              <span class="ts-result-card__media">{{ result.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 1025px) 33vw, (min-width: 768px) 50vw, 100vw', alt: '' }}</span>
            {%- endif -%}
            <span class="ts-result-card__body">
              <span class="ts-result-card__type">{% if result.object_type == 'article' %}{{ result.blog.title | default: 'Article' }}{% else %}Page{% endif %}</span>
              <span class="ts-result-card__title">{{ result.title }}</span>
              {%- if result.object_type == 'article' -%}
                {%- assign excerpt = result.excerpt_or_content | strip_html | truncatewords: 22 -%}
              {%- else -%}
                {%- assign excerpt = result.content | strip_html | truncatewords: 22 -%}
              {%- endif -%}
              {%- if excerpt != blank -%}<span class="ts-result-card__excerpt">{{ excerpt }}</span>{%- endif -%}
              <span class="ts-result-card__more">Read more <span aria-hidden="true">&rarr;</span></span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>
{%- endif -%}

{%- comment -%} Shown by the script below when the search returns nothing. {%- endcomment -%}
<div class="ts-search-empty" data-search-empty hidden>
  <div class="container">
    <span class="ts-search-empty__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" focusable="false"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5M8.5 8.5l5 5M13.5 8.5l-5 5"/></svg>
    </span>
    <h2 class="ts-search-empty__title">No results for &ldquo;{{ search.terms | escape }}&rdquo;</h2>
    <ul class="ts-search-empty__tips">
      <li>Check the spelling, or try a more general word such as &ldquo;shirt&rdquo; or &ldquo;hat&rdquo;.</li>
      <li>Browse a collection below, or <a href="{{ routes.all_products_collection_url }}">view all products</a>.</li>
    </ul>
    <h3 class="ts-search-empty__suggest">Popular collections</h3>
    <ul class="ts-collection-grid" role="list">
      {%- assign shown = 0 -%}
      {%- for collection in collections -%}
        {%- if shown >= 4 -%}{%- break -%}{%- endif -%}
        {%- if collection.handle == 'frontpage' or collection.products_count == 0 -%}{%- continue -%}{%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        <li>
          <a href="{{ collection.url }}" class="ts-collection-card">
            <span class="ts-collection-card__media">
              {%- assign c_image = collection.featured_image | default: collection.products.first.featured_image -%}
              {%- if c_image -%}{{ c_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250, 400, 500', sizes: '(min-width: 1025px) 25vw, 50vw', alt: '' }}{%- else -%}{%- render 'ts-icon', icon: 'compass' -%}{%- endif -%}
            </span>
            <span class="ts-collection-card__title">{{ collection.title }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

<script>
  // Search tabs (products vs articles/pages) and the no-results state.
  (function() {
    var tabs = [].slice.call(document.querySelectorAll('[data-search-tab]'));
    var select = function(tab, focus) {
      tabs.forEach(function(t) {
        var on = t === tab;
        t.setAttribute('aria-selected', on);
        t.tabIndex = on ? 0 : -1;
        document.querySelector('[data-search-panel="' + t.getAttribute('data-search-tab') + '"]').hidden = !on;
      });
      if (focus) tab.focus();
    };
    tabs.forEach(function(tab, i) {
      tab.addEventListener('click', function() { select(tab); });
      tab.addEventListener('keydown', function(e) {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        select(tabs[(i + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length], true);
      });
    });

    // Boost renders products after load; if it ends up with none (and there are no pages or articles),
    // swap in the friendly empty state.
    {%- if search.performed -%}
    var contentCount = {{ content_count }};
    var products = document.querySelector('.boost-pfs-filter-products');
    var empty = document.querySelector('[data-search-empty]');
    var panel = document.querySelector('[data-search-panel="products"]');
    var check = function() {
      var hasProducts = !!(products && products.querySelector('.boost-pfs-filter-product-item:not(.boost-pfs-filter-product-skeleton)'));
      var none = !hasProducts && contentCount === 0;
      empty.hidden = !none;
      if (panel) panel.classList.toggle('is-empty', none);
    };
    if (products && window.MutationObserver) new MutationObserver(check).observe(products, { childList: true, subtree: true });
    setTimeout(check, 2500);
    {%- endif -%}
  })();
</script>
{% endpaginate %}
