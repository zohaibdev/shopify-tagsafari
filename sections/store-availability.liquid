<div class="store-availability-container bottompad-half"
     data-section-id="{{ section.id }}"
     data-section-type="store-availability">
  {%- assign pick_up_availabilities = product_variant.store_availabilities | where: 'pick_up_enabled', true -%}
  {%- if pick_up_availabilities.size > 0 -%}
  <div class="store-availability-information table">
    {%- assign closest_location = pick_up_availabilities.first -%}
    <div class="table-cell top"><span class="icon icon-{%- if closest_location.available -%}check{%- else -%}times{%- endif -%}" focusable="false" aria-hidden="true"></span></div>
    <div class="store-availability-information-container table-cell top">
      {%- if closest_location.available -%}
      <p class="store-availability-information__title">{{ 'store_availability.general.pick_up_available_at_html' | t: location_name: closest_location.location.name }}<br/><span class="store-availability-information__stock store-availability-small-text"><small>{{ closest_location.pick_up_time }}</small></span></p>
      <p class="store-availability-information__stores"><a data-fancybox data-src="#StoreAvailabilityModal" href="javascript:void(0)" class="store-availability-information__link js-modal-open-store-availability-modal store-availability-small-text" data-store-availability-modal-open aria-haspopup="dialog"><small>{%- if pick_up_availabilities.size == 1 -%}{{ 'store_availability.general.view_store_info' | t }}{%- else -%}{{ 'store_availability.general.check_other_stores' | t }}{%- endif -%}</small></a></p>
      {%- else -%}
      <p class="store-availability-information__title">{{ 'store_availability.general.pick_up_unavailable_at_html' | t: location_name: closest_location.location.name }}</p>
      {%- if pick_up_availabilities.size > 1 -%}
      <p class="store-availability-information__stores"><a data-fancybox data-src="#StoreAvailabilityModal" href="javascript:void(0)" class="store-availability-information__link js-modal-open-store-availability-modal store-availability-small-text" data-store-availability-modal-open aria-haspopup="dialog"><small>{{ 'store_availability.general.check_other_stores' | t }}</small></a></p>
      {%- endif -%}
      {%- endif -%}
    </div>
  </div>

  <div class="store-availabilities-modal modal hidden" id="StoreAvailabilityModal">
    <div>
      <div class="store-availabilities-modal__header list">
        <span class="store-availabilities-modal__product-information">
          <h2 class="store-availabilities-modal__product-title" data-store-availability-modal-product-title>{{ product.title }}</h2>
          <p class="store-availabilities-modal__variant-title store-availability-small-text">{{ product_variant.title }}</p>
        </span>
      </div>
      <div class="store-availabilities-list" role="list">
        {%- for availability in pick_up_availabilities -%}
        <div class="store-availability-list__item list{% if forloop.last %} last{% endif %}">
          <p class="store-availability-list__location"><strong>{{ availability.location.name }}</strong><br/><span class="store-availability-list__stock store-availability-small-text"><small><span class="icon icon-{%- if availability.available -%}check{%- else -%}times{%- endif -%}" focusable="false" aria-hidden="true"></span> {%- if availability.available -%}{{ 'store_availability.general.pick_up_available' | t }}, {{ availability.pick_up_time | downcase }}{%- else -%}{{ 'store_availability.general.pick_up_currently_unavailable' | t }}{%- endif -%}</small></span></p>
          {%- assign address = availability.location.address -%}
          {{ address | format_address }}
          {%- if address.phone.size > 0 -%}<p class="store-availability-list__phone">{{ address.phone }}</p>{%- endif -%}
        </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": {},
  "settings": []
}
{% endschema %}
