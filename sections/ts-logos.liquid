{%- capture logo_items -%}
    {%- for block in section.blocks -%}
        {%- if block.settings.image != blank -%}
            {%- assign logo_alt = block.settings.image.alt | default: block.settings.name -%}
            <li class="ts-logos__item" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="ts-logos__link">{%- endif -%}
                {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 300, 400', sizes: '(min-width: 1025px) 220px, (min-width: 768px) 25vw, 45vw', alt: logo_alt, class: 'ts-logos__img' }}
                {%- if block.settings.name != blank -%}<span class="ts-logos__name">{{ block.settings.name }}</span>{%- endif -%}
                {%- if block.settings.link != blank -%}</a>{%- endif -%}
            </li>
        {%- endif -%}
    {%- endfor -%}
{%- endcapture -%}

<div class="{% if section.settings.tinted %}ts-section--tinted{% endif %}">
<div class="container">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
        <div class="title-block">
            {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
            {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        </div>
    {%- endif -%}
    {%- if logo_items != blank -%}
        <div class="ts-logos{% if section.settings.grayscale %} ts-logos--grayscale{% endif %}" style="--ts-logos-duration: {{ section.settings.duration }}s">
            {%- comment -%} The list is repeated once so the marquee loops seamlessly; the copy is hidden from assistive tech. {%- endcomment -%}
            <div class="ts-logos__track">
                <ul class="ts-logos__list" role="list">{{ logo_items }}</ul>
                <ul class="ts-logos__list ts-logos__list--copy" role="list" aria-hidden="true" inert>{{ logo_items }}</ul>
            </div>
        </div>
    {%- endif -%}
</div>
</div>

{% schema %}
{
  "name": "Logos Carousel",
  "tag": "section",
  "class": "ts-section",
  "max_blocks": 30,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Member & Supporter of These Fine Organizations"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro text"
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Scroll speed (seconds per loop)",
      "min": 10,
      "max": 90,
      "step": 5,
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "Show logos in grey, colour on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "tinted",
      "label": "Tinted background",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "info": "Shown under the logo and used as alt text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logos Carousel",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
