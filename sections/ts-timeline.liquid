<div class="{% if section.settings.tinted %}ts-section--tinted{% endif %}">
<div class="container">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
        <div class="title-block">
            {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
            {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        </div>
    {%- endif -%}
    <ol class="ts-timeline{% if section.settings.layout == 'horizontal' %} ts-timeline--horizontal{% endif %}" style="--count: {{ section.blocks.size | at_least: 1 }}">
        {%- for block in section.blocks -%}
            <li class="ts-timeline__item" {{ block.shopify_attributes }}>
                <span class="ts-timeline__marker" aria-hidden="true"></span>
                <span class="ts-timeline__year">{{ block.settings.year }}</span>
                <div class="ts-timeline__body">
                    {%- if block.settings.image != blank -%}
                        {{ block.settings.image | image_url: width: 600 | image_tag: class: 'ts-timeline__image', loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 1025px) 280px, (min-width: 768px) 45vw, 90vw', alt: block.settings.image.alt }}
                    {%- endif -%}
                    <h3 class="ts-timeline__title">{{ block.settings.title }}</h3>
                    <div class="ts-rte">{{ block.settings.text }}</div>
                </div>
            </li>
        {%- endfor -%}
    </ol>
</div>
</div>

{% schema %}
{
  "name": "Timeline",
  "tag": "section",
  "class": "ts-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Story"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro text"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "vertical",
      "info": "Horizontal works best with 3 to 5 milestones",
      "options": [
        { "value": "vertical", "label": "Vertical" },
        { "value": "horizontal", "label": "Horizontal" }
      ]
    },
    {
      "type": "checkbox",
      "id": "tinted",
      "label": "Tinted background",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Milestone",
      "settings": [
        {
          "type": "text",
          "id": "year",
          "label": "Year or period",
          "default": "1990"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Milestone"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Describe what happened.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Timeline",
      "blocks": [
        { "type": "milestone" },
        { "type": "milestone" },
        { "type": "milestone" }
      ]
    }
  ]
}
{% endschema %}
