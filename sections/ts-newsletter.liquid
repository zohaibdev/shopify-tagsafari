{%- assign form_id = 'Newsletter-' | append: section.id -%}
{%- assign image = section.settings.image -%}
{%- assign image_style = section.settings.image_style -%}
{%- if image == blank -%}{%- assign image_style = 'none' -%}{%- endif -%}
{%- capture band_style -%}
    --ts-nl-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    {%- if section.settings.text_color != blank and section.settings.text_color != 'rgba(0,0,0,0)' %} --ts-nl-text: {{ section.settings.text_color }};{% endif -%}
    {%- if section.settings.accent_color != blank and section.settings.accent_color != 'rgba(0,0,0,0)' %} --ts-nl-accent: {{ section.settings.accent_color }};{% endif -%}
    {%- if section.settings.background_color != blank and section.settings.background_color != 'rgba(0,0,0,0)' %} --ts-nl-bg: {{ section.settings.background_color }};{% endif -%}
{%- endcapture -%}

<div class="ts-newsletter-band ts-newsletter-band--{{ section.settings.background }} ts-newsletter-band--image-{{ image_style }} ts-newsletter-band--{{ section.settings.layout }}" id="newsletter" style="{{ band_style | strip_newlines }}">
    {%- if image_style == 'overlay' -%}
        {{ image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '800, 1200, 1600, 2400', sizes: '100vw', alt: '', class: 'ts-newsletter-band__bg' }}
    {%- endif -%}
    <div class="container">
        <div class="ts-newsletter{% if image_style == 'side' %} ts-newsletter--with-image{% endif %}">
            {%- if image_style == 'side' -%}
                <div class="ts-newsletter__media">
                    {%- assign image_alt = image.alt | default: section.settings.heading -%}
                    {{ image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200', sizes: '(min-width: 768px) 45vw, 100vw', alt: image_alt }}
                </div>
            {%- endif -%}

            <div class="ts-newsletter__intro">
                {%- if section.settings.eyebrow != blank -%}
                    <span class="ts-newsletter__eyebrow">{{ section.settings.eyebrow }}</span>
                {%- endif -%}
                {%- if section.settings.heading != blank -%}
                    <h2 class="ts-newsletter__heading">{{ section.settings.heading }}</h2>
                {%- endif -%}
                {%- if section.settings.text != blank -%}
                    <div class="ts-newsletter__text">{{ section.settings.text }}</div>
                {%- endif -%}
                {%- if section.blocks.size > 0 -%}
                    <ul class="ts-newsletter__features" role="list">
                        {%- for block in section.blocks -%}
                            <li class="ts-newsletter__feature" {{ block.shopify_attributes }}>{%- render 'ts-icon', icon: block.settings.icon -%}<span>{{ block.settings.text }}</span></li>
                        {%- endfor -%}
                    </ul>
                {%- endif -%}
            </div>

            <div class="ts-newsletter__card">
                {%- comment -%} Shopify customer form: signs the visitor up as a customer who accepts email marketing. {%- endcomment -%}
                {%- form 'customer', id: form_id, class: 'ts-newsletter__form ts-form' -%}
                    <input type="hidden" name="contact[tags]" value="newsletter">
                    {%- if form.posted_successfully? -%}
                        <p class="ts-form__notice ts-form__notice--success" role="status" tabindex="-1" autofocus>{{ section.settings.success_message }}</p>
                    {%- else -%}
                        {%- if form.errors -%}
                            <p class="ts-form__notice ts-form__notice--error" id="{{ form_id }}-error" role="alert" tabindex="-1" autofocus>
                                {%- if form.errors contains 'email' -%}
                                    {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}.
                                {%- else -%}
                                    {{ form.errors | default_errors }}
                                {%- endif -%}
                            </p>
                        {%- endif -%}
                        <label class="ts-newsletter__label" for="{{ form_id }}-email">Email address</label>
                        <div class="ts-newsletter__row">
                            <input
                                type="email"
                                id="{{ form_id }}-email"
                                name="contact[email]"
                                class="ts-newsletter__input"
                                value="{{ form.email }}"
                                placeholder="you@example.com"
                                autocomplete="email"
                                autocapitalize="off"
                                spellcheck="false"
                                required
                                aria-required="true"
                                {%- if form.errors %} aria-invalid="true" aria-describedby="{{ form_id }}-error"{% endif %}
                            >
                            <button type="submit" class="ts-newsletter__button">{{ section.settings.button_label }}</button>
                        </div>
                        {%- if section.settings.disclaimer != blank -%}
                            <div class="ts-newsletter__disclaimer">{{ section.settings.disclaimer }}</div>
                        {%- endif -%}
                    {%- endif -%}
                {%- endform -%}
                {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
                    <a href="{{ section.settings.link_url }}" class="ts-newsletter__link">{{ section.settings.link_label }} <span aria-hidden="true">&rarr;</span></a>
                {%- endif -%}
            </div>
        </div>
    </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "ts-section ts-section--newsletter",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Newsletter"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the adventure"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Safari stories, travel tips and new arrivals, straight to your inbox.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for subscribing! Look out for our next email."
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Small print",
      "info": "Optional, e.g. a link to your privacy policy"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Secondary link label",
      "info": "Optional text link under the form, e.g. Read our blog"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Secondary link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "split",
      "options": [
        { "value": "stacked", "label": "Centred" },
        { "value": "split", "label": "Text left, form right" }
      ]
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "panel",
      "options": [
        { "value": "panel", "label": "Rounded sand panel" },
        { "value": "tinted", "label": "Full-width sand band" },
        { "value": "brand", "label": "Full-width brand green" },
        { "value": "none", "label": "None" }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_style",
      "label": "Image style",
      "default": "overlay",
      "options": [
        { "value": "overlay", "label": "Full background with dark overlay" },
        { "value": "side", "label": "Beside the content" }
      ]
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay darkness",
      "min": 20,
      "max": 85,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "header",
      "content": "Colours",
      "info": "Leave blank to use the theme colours for the chosen background."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Eyebrow and icon colour"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour",
      "info": "Used by the panel and band backgrounds"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Highlight",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "mail",
          "options": [
            { "value": "mail", "label": "Mail" },
            { "value": "tag", "label": "Tag" },
            { "value": "gift", "label": "Gift" },
            { "value": "compass", "label": "Compass" },
            { "value": "star", "label": "Star" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "globe", "label": "Globe" }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Member-only offers"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
