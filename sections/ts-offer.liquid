{%- assign steps = section.blocks | where: 'type', 'step' -%}
{%- assign codes = section.blocks | where: 'type', 'code' -%}

<div class="ts-offer-band{% if section.settings.tinted %} ts-section--tinted{% endif %}">
<div class="container">
    <div class="ts-offer">
        <div class="ts-offer__intro">
            {%- if section.settings.image != blank -%}
                <div class="ts-offer__media">
                    {%- assign offer_alt = section.settings.image.alt | default: section.settings.heading -%}
                    {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200', sizes: '(min-width: 1025px) 50vw, 100vw', alt: offer_alt }}
                </div>
            {%- endif -%}
            <div class="ts-offer__text">
                {%- if section.settings.eyebrow != blank -%}<span class="ts-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
                {%- if section.settings.heading != blank -%}<h2 class="ts-heading">{{ section.settings.heading }}</h2>{%- endif -%}
                {%- if section.settings.text != blank -%}<div class="ts-rte">{{ section.settings.text }}</div>{%- endif -%}
            </div>
        </div>

        <div class="ts-offer__card">
            {%- if section.settings.value != blank -%}
                <p class="ts-offer__value">{{ section.settings.value }}</p>
            {%- endif -%}
            {%- for block in codes -%}
                <div class="ts-coupon" {{ block.shopify_attributes }}>
                    {%- if block.settings.label != blank -%}<p class="ts-coupon__label" id="coupon-{{ block.id }}-label">{{ block.settings.label }}</p>{%- endif -%}
                    <div class="ts-coupon__row">
                        <code class="ts-coupon__code" id="coupon-{{ block.id }}">{{ block.settings.code }}</code>
                        <button type="button" class="ts-coupon__copy" data-copy-code="{{ block.settings.code | escape }}" aria-describedby="coupon-{{ block.id }}">
                            <span class="ts-coupon__copy-label" data-copy-label>Copy code</span>
                        </button>
                    </div>
                </div>
            {%- endfor -%}
            <p class="ts-coupon__status" role="status" aria-live="polite" data-copy-status></p>
            {%- if section.settings.validity != blank -%}
                <div class="ts-offer__validity ts-rte">{{ section.settings.validity }}</div>
            {%- endif -%}
            {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
                <a href="{{ section.settings.button_link }}" class="th-btn ts-offer__button">{{ section.settings.button_label }}</a>
            {%- endif -%}
        </div>
    </div>

    {%- if steps.size > 0 -%}
        <div class="ts-offer__steps">
            {%- if section.settings.steps_heading != blank -%}<h3 class="ts-offer__steps-title">{{ section.settings.steps_heading }}</h3>{%- endif -%}
            <ol class="ts-steps" style="--col: {{ steps.size | at_most: 4 }}">
                {%- for block in steps -%}
                    <li class="ts-steps__item" {{ block.shopify_attributes }}>
                        <span class="ts-steps__icon">{%- render 'ts-icon', icon: block.settings.icon -%}</span>
                        <span class="ts-steps__number" aria-hidden="true">{{ forloop.index }}</span>
                        <strong class="ts-steps__title">{{ block.settings.title }}</strong>
                        {%- if block.settings.text != blank -%}<span class="ts-steps__text">{{ block.settings.text }}</span>{%- endif -%}
                    </li>
                {%- endfor -%}
            </ol>
        </div>
    {%- endif -%}
</div>
</div>

<script>
  // Copy-to-clipboard for discount codes, with a visible and announced "copied" state.
  (function() {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var status = root.querySelector('[data-copy-status]');
    root.querySelectorAll('[data-copy-code]').forEach(function(button) {
      button.addEventListener('click', function() {
        var code = button.getAttribute('data-copy-code');
        var done = function(ok) {
          var label = button.querySelector('[data-copy-label]');
          label.textContent = ok ? 'Copied!' : 'Copy failed';
          button.classList.toggle('is-copied', ok);
          if (status) status.textContent = ok ? 'Code ' + code + ' copied to clipboard.' : 'Could not copy. Please select the code and copy it.';
          clearTimeout(button._reset);
          button._reset = setTimeout(function() { label.textContent = 'Copy code'; button.classList.remove('is-copied'); }, 2500);
        };
        // Older-browser copy from a temporary field; used when the Clipboard API is missing or refused.
        var legacyCopy = function() {
          var field = document.createElement('textarea');
          field.value = code;
          field.setAttribute('readonly', '');
          field.style.position = 'absolute';
          field.style.left = '-9999px';
          document.body.appendChild(field);
          field.select();
          var ok = false;
          try { ok = document.execCommand('copy'); } catch (e) {}
          field.remove();
          if (!ok) {
            // Leave the code selected so it can be copied by hand.
            var range = document.createRange();
            range.selectNodeContents(button.parentNode.querySelector('code'));
            var selection = window.getSelection();
            selection.removeAllRanges();
            selection.addRange(range);
          }
          done(ok);
        };
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(code).then(function() { done(true); }, legacyCopy);
        } else {
          legacyCopy();
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Discount Offer",
  "tag": "section",
  "class": "ts-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Exclusive offer"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discount"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text"
    },
    {
      "type": "text",
      "id": "value",
      "label": "Offer value",
      "default": "5% OFF",
      "info": "Shown large on the offer card"
    },
    {
      "type": "richtext",
      "id": "validity",
      "label": "Validity and conditions",
      "info": "e.g. who the code is for, expiry date, exclusions"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start Shopping"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "steps_heading",
      "label": "Steps heading",
      "default": "How to redeem"
    },
    {
      "type": "checkbox",
      "id": "tinted",
      "label": "Tinted background",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "code",
      "name": "Discount code",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Your discount code"
        },
        {
          "type": "text",
          "id": "code",
          "label": "Code",
          "default": "CODE5"
        }
      ]
    },
    {
      "type": "step",
      "name": "Redeem step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "check",
          "options": [
            { "value": "shirt", "label": "Shirt" },
            { "value": "tag", "label": "Tag" },
            { "value": "percent", "label": "Percent" },
            { "value": "check", "label": "Check" },
            { "value": "gift", "label": "Gift" },
            { "value": "truck", "label": "Truck" },
            { "value": "star", "label": "Star" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Discount Offer",
      "blocks": [
        { "type": "code" },
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
