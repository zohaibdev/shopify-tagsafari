<div class="{% if section.settings.tinted %}ts-section--tinted{% endif %}">
<div class="container">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
        <div class="title-block">
            {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
            {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        </div>
    {%- endif -%}
    <div class="ts-card-grid" style="--col: {{ section.settings.columns }}">
        {%- for block in section.blocks -%}
            <article class="ts-topic{% if block.settings.link != blank %} ts-topic--link{% endif %}" {{ block.shopify_attributes }}>
                <span class="ts-topic__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                {%- if block.settings.eyebrow != blank -%}
                    <p class="ts-post__meta">{{ block.settings.eyebrow }}</p>
                {%- endif -%}
                <h3 class="ts-topic__title">
                    {%- if block.settings.link != blank -%}
                        <a href="{{ block.settings.link }}">{{ block.settings.title }}</a>
                    {%- else -%}
                        {{ block.settings.title }}
                    {%- endif -%}
                </h3>
                {%- if block.settings.link != blank -%}
                    <span class="ts-post__link">{{ block.settings.link_label | default: 'Read more' }}</span>
                {%- endif -%}
            </article>
        {%- endfor -%}
    </div>
</div>
</div>

{% schema %}
{
  "name": "Blog Topic Cards",
  "tag": "section",
  "class": "ts-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Safari topics"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro text"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "tinted",
      "label": "Tinted background",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Topic",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow text"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Article title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Card is not clickable until set"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Read more"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blog Topic Cards",
      "blocks": [
        { "type": "link" },
        { "type": "link" },
        { "type": "link" },
        { "type": "link" }
      ]
    }
  ]
}
{% endschema %}
