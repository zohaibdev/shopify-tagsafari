      <div class="header-searchbar hs-desktop search open-slide">
        <div class="container full clearfix">
          <div class="twelve">
            {%- render 'search', search_class: 'header text-center' -%}
          </div>
        </div>
      </div>


<div class="hero__wrapper" style="background-image: url({{ section.settings.background_image | img_url: '2048x2048' }});">
    <div class="container">
        <div class="hero__content">
            <h1 class="hero__heading">{{ section.settings.heading }}</h1>
            <p class="hero__subheading">{{ section.settings.subheading }}</p>
            <div class="hero__buttons">
                {% if section.settings.button_1_link %}
                    <a href="{{ section.settings.button_1_link }}" class="th-btn">{{ section.settings.button_1_label }}</a>
                {% endif %}
                {% if section.settings.button_2_link %}
                    <a href="{{ section.settings.button_2_link }}" class="th-btn">{{ section.settings.button_2_label }}</a>
                {% endif %}
                {% if section.settings.button_3_link %}
                    <a href="{{ section.settings.button_3_link }}" class="th-btn th-btn--white">{{ section.settings.button_3_label }}</a>
                {% endif %}
            </div>
        </div>
    </div>
</div>


{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Authentic African Safari Clothing & Gear"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Made in Africa for safari, travel, and outdoor adventure."
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Button 1 label",
      "default": "Shop Men"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button 2 label",
      "default": "Shop Women"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    },
    {
      "type": "text",
      "id": "button_3_label",
      "label": "Button 3 label",
      "default": "Explore Safari Gear"
    },
    {
      "type": "url",
      "id": "button_3_link",
      "label": "Button 3 link"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 25
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
