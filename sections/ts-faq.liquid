<div class="{% if section.settings.tinted %}ts-section--tinted{% endif %}">
<div class="container">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
        <div class="title-block">
            {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
            {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        </div>
    {%- endif -%}
    <div class="ts-faq">
        {%- for block in section.blocks -%}
            {%- case block.type -%}
                {%- when 'group' -%}
                    <h3 class="ts-faq__group" {{ block.shopify_attributes }}>{{ block.settings.title }}</h3>
                {%- when 'question' -%}
                    {%- comment -%} Native details/summary: keyboard and screen-reader friendly with no script. {%- endcomment -%}
                    <details class="ts-faq__item" {{ block.shopify_attributes }}{% if section.settings.open_first and forloop.first %} open{% endif %}>
                        <summary class="ts-faq__question">
                            <span>{{ block.settings.question }}</span>
                            <span class="ts-faq__toggle" aria-hidden="true"></span>
                        </summary>
                        <div class="ts-faq__answer ts-rte">{{ block.settings.answer }}</div>
                    </details>
            {%- endcase -%}
        {%- endfor -%}
    </div>
</div>
</div>

{%- assign questions = section.blocks | where: 'type', 'question' -%}
{%- if questions.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in questions -%}
    {
      "@type": "Question",
      "name": {{ block.settings.question | strip_html | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | json }} }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ Accordion",
  "tag": "section",
  "class": "ts-section",
  "max_blocks": 50,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro text"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "tinted",
      "label": "Tinted background",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Group heading",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "General"
        }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion",
      "blocks": [
        { "type": "question" },
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
