{%- comment -%}
  Three-column product info row: benefit bullets, an accordion, and a brand panel.
  Bullets and accordion rows are blocks so the order is editable; the brand panel
  is a fixed third column driven by section settings.
{%- endcomment -%}

{%- assign bullets = section.blocks | where: 'type', 'bullet' -%}
{%- assign rows = section.blocks | where: 'type', 'accordion' -%}

<div class="info-columns">
  {%- if bullets.size > 0 -%}
    <div class="info-columns__col info-columns__benefits">
      {%- if section.settings.benefits_heading != blank -%}
        <h2 class="info-columns__heading">{{ section.settings.benefits_heading }}</h2>
      {%- endif -%}
      <ul class="info-columns__list">
        {%- for block in bullets -%}
          <li {{ block.shopify_attributes }}>
            <span class="info-columns__tick" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M2 8.5L6 12.5L14 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            {{ block.settings.text }}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}

  {%- if rows.size > 0 -%}
    <div class="info-columns__col info-columns__accordion">
      {%- for block in rows -%}
        <details class="accordion" {{ block.shopify_attributes }}>
          <summary class="accordion__summary">
            <span>{{ block.settings.title }}</span>
            <span class="accordion__icon" aria-hidden="true"></span>
          </summary>
          <div class="accordion__content rte">
            {%- if block.settings.use_product_description -%}
              {{ product.description }}
            {%- else -%}
              {{ block.settings.content }}
            {%- endif -%}
          </div>
        </details>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.brand_heading != blank or section.settings.brand_text != blank -%}
    <div class="info-columns__col info-columns__brand">
      {%- if section.settings.brand_image -%}
        <img
          class="info-columns__brand-image"
          src="{{ section.settings.brand_image | img_url: '600x' }}"
          alt=""
          loading="lazy"
        >
      {%- endif -%}
      {%- if section.settings.brand_heading != blank -%}
        <h2 class="info-columns__heading">{{ section.settings.brand_heading }}</h2>
      {%- endif -%}
      <div class="info-columns__brand-text rte">
        {{ section.settings.brand_text }}
      </div>
      {%- if section.settings.brand_button_label != blank and section.settings.brand_button_link != blank -%}
        <a class="info-columns__brand-button" href="{{ section.settings.brand_button_link }}">
          {{ section.settings.brand_button_label }}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Product Info Columns",
  "tag": "section",
  "class": "info-columns-section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "benefits_heading",
      "label": "Benefits heading",
      "default": "Why You'll Love It"
    },
    {
      "type": "header",
      "content": "Brand panel"
    },
    {
      "type": "text",
      "id": "brand_heading",
      "label": "Heading",
      "default": "Helping Africa Through Trade, Not Aid"
    },
    {
      "type": "richtext",
      "id": "brand_text",
      "label": "Text",
      "default": "<p>Every TAG Safari product is <strong>made in Africa</strong>.</p>"
    },
    {
      "type": "image_picker",
      "id": "brand_image",
      "label": "Background image",
      "info": "Sits behind the text, bottom right. A map or watermark works best."
    },
    {
      "type": "text",
      "id": "brand_button_label",
      "label": "Button label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "brand_button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Benefit bullet",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Lightweight 100% cotton keeps you cool"
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion row",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Product Details"
        },
        {
          "type": "checkbox",
          "id": "use_product_description",
          "label": "Use the product description",
          "info": "Pulls the description from the product instead of the Content field below.",
          "default": false
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Info Columns",
      "blocks": [
        { "type": "bullet" },
        { "type": "bullet" },
        { "type": "bullet" },
        { "type": "accordion" },
        { "type": "accordion" },
        { "type": "accordion" }
      ]
    }
  ]
}
{% endschema %}
