{%- comment -%}
  Frequently Bought Together.

  Companion products are picked by hand in the theme editor, one product block
  each, so the whole card renders server-side in a single pass.

  Because this section lives on the shared product template, the same companion
  blocks are offered on every product. Companions whose gender conflicts with the
  product being viewed are dropped so a men's page never cross-sells a women's
  garment. Items with no gender signal are treated as unisex and always offered.
{%- endcomment -%}

{%- assign main_variant = product.selected_or_first_available_variant -%}

{%- capture main_signals -%}
  {{ product.handle }} {{ product.title }} {{ product.type }} {{ product.tags | join: ' ' }}
{%- endcapture -%}
{%- assign main_signals = main_signals | downcase -%}
{%- assign main_gender = '' -%}
{%- comment -%} "women" must be tested first - it contains "men". {%- endcomment -%}
{%- if main_signals contains 'women' -%}
  {%- assign main_gender = 'women' -%}
{%- elsif main_signals contains 'men' -%}
  {%- assign main_gender = 'men' -%}
{%- endif -%}

{%- comment -%} A bundle needs at least one usable companion to make sense. {%- endcomment -%}
{%- assign companion_ids = ',' -%}
{%- for block in section.blocks -%}
  {%- assign companion = block.settings.product -%}
  {%- if companion == blank or companion.selected_or_first_available_variant == blank -%}
    {%- continue -%}
  {%- endif -%}

  {%- capture companion_signals -%}
    {{ companion.handle }} {{ companion.title }} {{ companion.type }} {{ companion.tags | join: ' ' }}
  {%- endcapture -%}
  {%- assign companion_signals = companion_signals | downcase -%}
  {%- assign companion_gender = '' -%}
  {%- if companion_signals contains 'women' -%}
    {%- assign companion_gender = 'women' -%}
  {%- elsif companion_signals contains 'men' -%}
    {%- assign companion_gender = 'men' -%}
  {%- endif -%}

  {%- if main_gender != '' and companion_gender != '' and companion_gender != main_gender -%}
    {%- continue -%}
  {%- endif -%}

  {%- assign companion_ids = companion_ids | append: block.id | append: ',' -%}
{%- endfor -%}

{%- if companion_ids != ',' -%}
  <fbt-card
    class="fbt"
    data-discount="{{ section.settings.discount_percentage }}"
    data-discount-code="{{ section.settings.discount_code | escape }}"
    data-savings-label="{{ section.settings.savings_label | escape }}"
    data-money-format="{{ shop.money_format | escape }}"
  >
    <div class="fbt__head">
      <h2 class="fbt__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.discount_percentage > 0 and section.settings.badge_text != blank -%}
        <span class="fbt__badge">{{ section.settings.badge_text }}</span>
      {%- endif -%}
    </div>

    <div class="fbt__body">
      <div class="fbt__items">
        {%- comment -%}
          The product being viewed is always part of the bundle, so it counts
          towards the total and is sent to the cart, but it gets no row of its
          own - the customer is already looking at it.
        {%- endcomment -%}
        <input
          type="checkbox"
          checked
          disabled
          hidden
          aria-hidden="true"
          data-fbt-toggle
          data-fbt-main
          data-variant-id="{{ main_variant.id }}"
          data-price="{{ main_variant.price }}"
          style="display:none;"
        >

        <div data-fbt-recos>
          {%- for block in section.blocks -%}
            {%- capture block_key -%},{{ block.id }},{%- endcapture -%}
            {%- assign companion = block.settings.product -%}
            {%- assign companion_variant = companion.selected_or_first_available_variant -%}
            {%- if companion_ids contains block_key -%}
              <div class="fbt__item" data-fbt-item {{ block.shopify_attributes }}>
                <label class="fbt__check">
                  <input
                    type="checkbox"
                    {% if block.settings.checked_by_default %}checked{% endif %}
                    data-fbt-toggle
                    data-variant-id="{{ companion_variant.id }}"
                    data-price="{{ companion_variant.price }}"
                    aria-label="{{ 'products.product.add_to_cart' | t }} {{ companion.title | escape }}"
                  >
                  <span class="fbt__check-box" aria-hidden="true"></span>
                </label>
                <a class="fbt__thumb" href="{{ companion.url }}" tabindex="-1">
                  {%- if companion.featured_image -%}
                    <img
                      src="{{ companion.featured_image | img_url: '160x' }}"
                      alt="{{ companion.featured_image.alt | escape }}"
                      loading="lazy"
                      width="80"
                      height="80"
                    >
                  {%- endif -%}
                </a>
                <div class="fbt__info">
                  <a class="fbt__title" href="{{ companion.url }}">{{ companion.title }}</a>
                  {%- unless companion_variant.title contains 'Default' -%}
                    <span class="fbt__variant">{{ companion_variant.title }}</span>
                  {%- endunless -%}
                  <span class="fbt__price">{{ companion_variant.price | money }}</span>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="fbt__summary">
        <p class="fbt__total">
          <span class="fbt__total-label">{{ section.settings.total_label }}</span>
          <s class="fbt__total-was" data-fbt-was hidden></s>
          <span class="fbt__total-now" data-fbt-now></span>
        </p>
        {%- if section.settings.discount_percentage > 0 -%}
          <p class="fbt__savings" data-fbt-savings hidden></p>
        {%- endif -%}
        <button type="button" class="fbt__submit" data-fbt-submit>
          {{ section.settings.button_label }}
        </button>
        <p class="fbt__error" data-fbt-error hidden role="alert"></p>
        <a class="fbt__individual" href="#" data-fbt-individual>
          {{ section.settings.secondary_link_label }}
        </a>
      </div>
    </div>
  </fbt-card>

  <script>
    if (!customElements.get('fbt-card')) {
      customElements.define(
        'fbt-card',
        class FbtCard extends HTMLElement {
          connectedCallback() {
            this.addEventListener('change', (event) => {
              if (event.target.matches('[data-fbt-toggle]')) this.recalculate();
            });
            this.querySelector('[data-fbt-submit]').addEventListener('click', () => this.addBundle());
            const individual = this.querySelector('[data-fbt-individual]');
            if (individual) {
              individual.addEventListener('click', (event) => {
                event.preventDefault();
                this.uncheckCompanions();
              });
            }
            this.syncMainVariant();
            this.recalculate();
          }

          // Keep the bundle's copy of the main product in step with the variant
          // picker in the product form above it.
          syncMainVariant() {
            const form = document.querySelector('form[action$="/cart/add"]');
            const input = form && form.querySelector('[name="id"]');
            if (!input) return;
            const mainToggle = this.querySelector('[data-fbt-main]');
            const apply = () => {
              if (input.value) mainToggle.dataset.variantId = input.value;
            };
            apply();
            form.addEventListener('change', apply);
          }

          get toggles() {
            return Array.from(this.querySelectorAll('[data-fbt-toggle]'));
          }

          get selected() {
            return this.toggles.filter((toggle) => toggle.checked);
          }

          money(cents) {
            if (window.Shopify && typeof Shopify.formatMoney === 'function') {
              return Shopify.formatMoney(cents, this.dataset.moneyFormat);
            }
            return (cents / 100).toFixed(2);
          }

          recalculate() {
            const full = this.selected.reduce((sum, toggle) => sum + parseInt(toggle.dataset.price, 10), 0);
            const percent = parseFloat(this.dataset.discount) || 0;
            // Only a real multi-item bundle earns the bundle discount.
            const discountApplies = percent > 0 && this.selected.length > 1;
            const saved = discountApplies ? Math.round((full * percent) / 100) : 0;

            const was = this.querySelector('[data-fbt-was]');
            const now = this.querySelector('[data-fbt-now]');
            const savings = this.querySelector('[data-fbt-savings]');

            now.textContent = this.money(full - saved);
            was.hidden = !discountApplies;
            if (discountApplies) was.textContent = this.money(full);
            if (savings) {
              savings.hidden = !discountApplies;
              if (discountApplies) {
                savings.textContent = `${this.dataset.savingsLabel || 'You save'} ${this.money(saved)} (${percent}%)`;
              }
            }
            this.querySelector('[data-fbt-submit]').disabled = this.selected.length === 0;
          }

          uncheckCompanions() {
            this.toggles.forEach((toggle) => {
              if (!toggle.hasAttribute('data-fbt-main')) toggle.checked = false;
            });
            this.recalculate();
          }

          async addBundle() {
            const button = this.querySelector('[data-fbt-submit]');
            const error = this.querySelector('[data-fbt-error]');
            const items = this.selected.map((toggle) => ({ id: toggle.dataset.variantId, quantity: 1 }));
            if (!items.length) return;

            button.disabled = true;
            button.classList.add('is-loading');
            error.hidden = true;

            try {
              const response = await fetch('/cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ items }),
              });
              const data = await response.json();
              if (!response.ok) throw new Error(data.description || data.message);

              // The discount itself lives in Shopify admin; this only claims it.
              const code = this.dataset.discountCode;
              window.location.href = code
                ? `/discount/${encodeURIComponent(code)}?redirect=/cart`
                : '/cart';
            } catch (e) {
              error.textContent = e.message || 'Something went wrong. Please try again.';
              error.hidden = false;
              button.disabled = false;
              button.classList.remove('is-loading');
            }
          }
        }
      );
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Frequently Bought",
  "tag": "section",
  "class": "fbt-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Bought Together"
    },
    {
      "type": "paragraph",
      "content": "Add a companion product block for each item to bundle with this product. With no companion products the section hides itself."
    },
    {
      "type": "header",
      "content": "Bundle discount"
    },
    {
      "type": "paragraph",
      "content": "The discount below is display only. You must also create a matching discount in Shopify admin — the section applies it by sending the customer through the discount link."
    },
    {
      "type": "range",
      "id": "discount_percentage",
      "label": "Discount percentage",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "default": 10
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount code",
      "info": "The code created in Shopify admin, e.g. BUNDLE10. Leave empty to send customers straight to the cart with no discount applied."
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "SAVE 10% ON THIS BUNDLE"
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total label",
      "default": "Bundle Total"
    },
    {
      "type": "text",
      "id": "savings_label",
      "label": "Savings label",
      "default": "You save"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add Bundle to Cart"
    },
    {
      "type": "text",
      "id": "secondary_link_label",
      "label": "Secondary link label",
      "default": "Add items individually"
    }
  ],
  "blocks": [
    {
      "type": "companion",
      "name": "Companion product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "checkbox",
          "id": "checked_by_default",
          "label": "Ticked by default",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Frequently Bought",
      "blocks": [{ "type": "companion" }, { "type": "companion" }]
    }
  ]
}
{% endschema %}
