{%- assign form_id = 'ContactForm-' | append: section.id -%}

<div class="container">
    <div class="ts-contact">
        <div class="ts-contact__info">
            {%- for block in section.blocks -%}
                <div class="ts-card" {{ block.shopify_attributes }}>
                    {%- if block.settings.icon != blank -%}
                        {{ block.settings.icon | image_url: width: 100 | image_tag: class: 'ts-card__icon', loading: 'lazy', alt: '' }}
                    {%- endif -%}
                    <h2 class="ts-card__title">{{ block.settings.title }}</h2>
                    <div class="ts-rte">{{ block.settings.text }}</div>
                </div>
            {%- endfor -%}
        </div>

        <div class="ts-contact__form">
            {%- if section.settings.heading != blank -%}
                <h2 class="ts-heading">{{ section.settings.heading }}</h2>
            {%- endif -%}
            {%- if section.settings.text != blank -%}
                <div class="ts-rte ts-contact__intro">{{ section.settings.text }}</div>
            {%- endif -%}
            {%- if section.settings.show_page_content and page.content != blank -%}
                <div class="ts-rte ts-contact__intro">{{ page.content }}</div>
            {%- endif -%}

            {%- form 'contact', id: form_id, class: 'ts-form' -%}
                {%- if section.settings.subject != blank -%}
                    <input type="hidden" name="contact[Subject]" value="{{ section.settings.subject | escape }}">
                {%- endif -%}
                {%- if form.posted_successfully? -%}
                    <div class="ts-form__notice ts-form__notice--success" role="status" tabindex="-1" autofocus>
                        <p>{{ 'contact.form.post_success' | t }}</p>
                    </div>
                {%- elsif form.errors -%}
                    <div class="ts-form__notice ts-form__notice--error" role="alert" tabindex="-1" autofocus>
                        <p>{{ 'contact.form.form_error' | t }}</p>
                    </div>
                {%- endif -%}



                <div class="ts-form__row">
                    <div class="ts-form__field">
                        <label for="{{ form_id }}-name">{{ 'contact.form.name' | t }}</label>
                        <input type="text" id="{{ form_id }}-name" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
                    </div>
                    <div class="ts-form__field">
                        <label for="{{ form_id }}-phone">{{ 'contact.form.phone' | t }}</label>
                        <input type="tel" id="{{ form_id }}-phone" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
                    </div>
                </div>

                <div class="ts-form__field">
                    <label for="{{ form_id }}-email">{{ 'contact.form.email' | t }} <span aria-hidden="true">*</span></label>
                    <input
                        type="email"
                        id="{{ form_id }}-email"
                        name="contact[email]"
                        autocomplete="email"
                        autocapitalize="off"
                        spellcheck="false"
                        required
                        aria-required="true"
                        value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                        {%- if form.errors contains 'email' %}
                            aria-invalid="true"
                            aria-describedby="{{ form_id }}-email-error"
                        {%- endif %}
                    >
                    {%- if form.errors contains 'email' -%}
                        <span id="{{ form_id }}-email-error" class="ts-form__error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}.</span>
                    {%- endif -%}
                </div>
                {%- assign reasons = section.settings.reason_options | newline_to_br | split: '<br />' -%}
                {%- if section.settings.reason_options != blank -%}
                    <div class="ts-form__field">
                        <label for="{{ form_id }}-reason">{{ section.settings.reason_label | default: 'Reason for contacting us' }} <span aria-hidden="true">*</span></label>
                        <select id="{{ form_id }}-reason" name="contact[{{ section.settings.reason_label | default: 'Reason for contacting us' | escape }}]" required aria-required="true">
                            <option value="" disabled selected>Please select an option</option>
                            {%- for reason in reasons -%}
                                {%- assign reason = reason | strip -%}
                                {%- if reason != blank -%}
                                    <option value="{{ reason | escape }}">{{ reason | escape }}</option>
                                {%- endif -%}
                            {%- endfor -%}
                        </select>
                    </div>
                {%- endif -%}
                <div class="ts-form__field">
                    <label for="{{ form_id }}-message">{{ 'contact.form.message' | t }} <span aria-hidden="true">*</span></label>
                    <textarea
                        id="{{ form_id }}-message"
                        name="contact[body]"
                        required
                        aria-required="true"
                        {%- if form.errors contains 'body' %}
                            aria-invalid="true"
                            aria-describedby="{{ form_id }}-message-error"
                        {%- endif %}
                    >{{ form.body }}</textarea>
                    {%- if form.errors contains 'body' -%}
                        <span id="{{ form_id }}-message-error" class="ts-form__error">{{ form.errors.translated_fields.body | capitalize }} {{ form.errors.messages.body }}.</span>
                    {%- endif -%}
                </div>

                <button type="submit" class="th-btn">{{ 'contact.form.send' | t }}</button>
                {%- render 'captcha-notice' -%}
            {%- endform -%}
        </div>
    </div>
</div>

{% schema %}
{
  "name": "Contact Form",
  "tag": "section",
  "class": "ts-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Form heading",
      "default": "Send us a message"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Form intro"
    },
    {
      "type": "checkbox",
      "id": "show_page_content",
      "label": "Show page content above the form",
      "default": false
    },
    {
      "type": "text",
      "id": "subject",
      "label": "Enquiry subject",
      "info": "Added to every message sent from this form"
    },
    {
      "type": "text",
      "id": "reason_label",
      "label": "Reason field label",
      "default": "Reason for contacting us"
    },
    {
      "type": "textarea",
      "id": "reason_options",
      "label": "Reason options",
      "info": "One per line. Leave blank to hide the field; when shown it is required."
    }
  ],
  "blocks": [
    {
      "type": "info",
      "name": "Contact detail",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Call us"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Add your contact details.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact Form",
      "blocks": [
        { "type": "info" },
        { "type": "info" }
      ]
    }
  ]
}
{% endschema %}
