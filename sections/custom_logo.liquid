<div class="cutn_logo">
  <h2>{{ section.settings.text1 }}</h2>
  <div class="logos_wrapper">
    {% for block in section.blocks %}
    <div class="cum_log">
      <img src="{{ block.settings.image | img_url: 'master'}}" >

      <p class="log_txt">{{ block.settings.text }}</p>
    </div>
    {% endfor %}

  </div>
</div>


{% schema %}
  {
    "name": "logo",
    "settings": [
  {
          "id": "text1",
          "type": "text",
          "label": "text"
}
],
"blocks": [
    {
      "type": "select",
      "name": "Add logo",
      "settings": [
        {
          "id": "image",
          "type": "image_picker",
       		"label": "image"
        },
        {
          "id": "text",
          "type": "text",
          "label": "text",
          "default": "Click here"
        }
      ]
    }
  ],
"presets": [
    {
      "name": "custom_logo",
      "category": "CTA button",
      "blocks": [
        { 
          "type": "select"
        },
        {
          "type": "select"
        }
      ]
    }
  ]

  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}
