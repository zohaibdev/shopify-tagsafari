<div class="container">
    <div class="trustpilot__content">
        {% if section.settings.heading != blank %}
        <div class="title-block">
            <h2 class="title-block__heading">{{ section.settings.heading }}</h2>
        </div>
      {% endif %}
        <div class="trustpilot__iframe">
            {{ section.settings.iframe }}
        </div>
    </div>
</div>



{% schema %}
{
  "name": "Trustpilot Reviews",
  "tag": "section",
  "class": "trustpilot",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Excellent Reviews"
    },
    {
      "type": "html",
      "id": "iframe",
      "label": "Iframe"
    }
  ],
  "presets": [
    {
      "name": "Trustpilot Reviews",
    }
  ]
}
{% endschema %}
