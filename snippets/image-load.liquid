{%- assign lazy_size = '1x' -%}
{%- assign sizex2 = size | times: 2 -%}
{%- assign id = id -%}
{%- assign img_url = img_src | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}
<img id="image-{{ id }}"
     class="lazywidth lazyload no-js-hide img-align {% unless forloop_first %}list {% endunless %}{% if img_src.aspect_ratio > 1 %}landscape{% elsif img_src.aspect_ratio < 1 %}vertical{% else %}square{% endif %}"
     src="{{ img_src | img_url: lazy_size }}"
     height="{% if datawidth == false %}{% if img_src.width < sizex2 %}{{ img_src.height }}{% else %}{{ sizex2 | divided_by: img_src.aspect_ratio }}{% endif %}{% else %}{% if img_src.width < size %}{{ img_src.height }}{% else %}{{ size | divided_by: img_src.aspect_ratio }}{% endif %}{% endif %}"
     width="{% if datawidth == false %}{% if img_src.width < sizex2 %}{{ img_src.width }}{% else %}{{ sizex2 }}{% endif %}{% else %}{% if img_src.width < size %}{{ img_src.width }}{% else %}{{ size }}{% endif %}{% endif %}"
     data-src="{{ img_url }}"
     data-widths="[{% if datawidth == false %}{{ size | times: 2 }}{% else %}200, 220, 300, 400, 500, 600, 700, 800, 900, 1000, 1100, 1200, 1300, 1400, 1500, 1600, 1700, 1800, 1900{% endif %}]"
     data-aspectratio="{{ img_src.aspect_ratio }}"
     data-sizes="auto"
     data-image
     alt="{{ alt | escape }}"
     style="max-width:{% if datawidth == false %}{% if img_src.width < sizex2 %}{{ img_src.width }}{% else %}{{ sizex2 }}{% endif %}{% else %}{% if img_src.width < size %}{{ img_src.width }}{% else %}{{ size }}{% endif %}{% endif %}px">
<noscript>{%- assign size = size | append: 'x' -%}<img class="lazywidth {% if img_src.aspect_ratio > 1 %}landscape{% elsif img_src.aspect_ratio < 1 %}vertical{% else %}square{% endif %} no-js hidden" src="{{ img_src | img_url: size }}" height="{% if datawidth == false %}{% if img_src.width < sizex2 %}{{ img_src.height }}{% else %}{{ sizex2 | divided_by: img_src.aspect_ratio }}{% endif %}{% else %}{% if img_src.width < size %}{{ img_src.height }}{% else %}{{ size | divided_by: img_src.aspect_ratio }}{% endif %}{% endif %}" width="{% if datawidth == false %}{% if img_src.width < sizex2 %}{{ img_src.width }}{% else %}{{ sizex2 }}{% endif %}{% else %}{% if img_src.width < size %}{{ img_src.width }}{% else %}{{ size }}{% endif %}{% endif %}" alt="{{ alt }}" style="max-width:{% if datawidth == false %}{% if img_src.width < sizex2 %}{{ img_src.width }}{% else %}{{ sizex2 }}{% endif %}{% else %}{% if img_src.width < size %}{{ img_src.width }}{% else %}{{ size }}{% endif %}{% endif %}px"></noscript>