<form action="{{ routes.search_url }}" method="get" class="search-form search-form-{{ section.id }} {{ search_class }}" role="search">
  <input type="hidden" name="options[unavailable_products]" value="show" />
  <input type="hidden" name="options[prefix]" value="last" />
  <input name="q" type="text" class="search-field" placeholder="Search safari clothing & gear..." aria-label="{{ 'general.search.placeholder' | t }}"/>
  <button type="submit" class="search-submit">
    <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-search" viewBox="0 0 64 64"><path d="M60.7 57.3L45.4 42c3.9-4.6 6.2-10.5 6.2-16.9C51.6 11.5 40.1 0 26.8 0S2 11.5 2 25.1s11.5 25.1 24.8 25.1c6.4 0 12.3-2.3 16.9-6.2l15.3 15.3c1 .9 2.3 1.4 3.7 1.4s2.7-.5 3.7-1.4c2-1.9 2-5 .1-6.9zM26.8 44c-10.4 0-18.9-8.5-18.9-18.9S16.4 6.2 26.8 6.2s18.9 8.5 18.9 18.9S37.2 44 26.8 44z"/></svg>
  </button>
</form>