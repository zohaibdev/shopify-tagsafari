    --arrow_right: '\e91e';
    --arrow_up: '\e91f';

    --rss: '\e927';
    --play: '\e940';
    --threed: '\e911';
    --bag: '\e917';
    --cart: '\e902';
    --search: '\e918';
    --account:'\e919';

    --pen: '\e920';
    --pencil: '\e921';
    --edit: '\e922';
    --pencil_ruler: '\e945';
    --fire: '\e95a';
    --cloud: '\e97b';
    --cloud_check: '\e98f';
    --shield: '\e9a1';
    --shield_check: '\e9a4';
    --shield_star: '\e9ac';
    --lock: '\e9b4';
    --lock_encrypt: '\e9ae';
    --gear: '\e9c5';
    --wrench: '\e9c6';
    --screwdriver: '\e9c8';
    --hammer: '\e9c9';
    --hammer_wrench: '\e9cb';
    --wrench_screwdriver: '\e9cc';
    --axe: '\e9ce';
